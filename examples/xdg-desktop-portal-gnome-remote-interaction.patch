From d5b131ec5451e23a6ac71a51e2132b48969911a0 Mon Sep 17 00:00:00 2001
From: rndhouse <rndhouse@protonmail.com>
Date: Thu, 13 Aug 2026 16:40:11 +0100
Subject: [PATCH] Show requester details in remote desktop dialog

---
 src/remotedesktopdialog.c  | 108 +++++++++++++++++++++++++++++++++++++
 src/remotedesktopdialog.ui |  29 ++++++++++
 2 files changed, 137 insertions(+)

diff --git a/src/remotedesktopdialog.c b/src/remotedesktopdialog.c
index 0466ae2..8c6c414 100644
--- a/src/remotedesktopdialog.c
+++ b/src/remotedesktopdialog.c
@@ -33,6 +33,8 @@ struct _RemoteDesktopDialog
   AdwSwitchRow *allow_remote_interaction_switch;
   AdwSwitchRow *allow_remote_clipboard_switch;
   GtkCheckButton *persist_check;
+  GtkLabel *requester_heading;
+  GtkLabel *requester_details;
   GtkWidget *screen_cast_widget;
   AdwHeaderBar *titlebar;
 
@@ -147,6 +149,105 @@ on_has_selection_changed (ScreenCastWidget *screen_cast_widget,
   update_button_sensitivity (dialog);
 }
 
+static void
+append_capability (GString *capabilities,
+                   const char *capability)
+{
+  if (capabilities->len > 0)
+    g_string_append (capabilities, ", ");
+
+  g_string_append (capabilities, capability);
+}
+
+static char *
+get_app_display_name (const char *app_id)
+{
+  g_autoptr(GAppInfo) info = NULL;
+  g_autofree char *desktop_id = NULL;
+
+  if (!app_id || strcmp (app_id, "") == 0)
+    return g_strdup (_("An app"));
+
+  if (g_str_has_suffix (app_id, ".desktop"))
+    desktop_id = g_strdup (app_id);
+  else
+    desktop_id = g_strconcat (app_id, ".desktop", NULL);
+
+  info = G_APP_INFO (g_desktop_app_info_new (desktop_id));
+  if (!info)
+    info = G_APP_INFO (g_desktop_app_info_new (app_id));
+
+  if (info)
+    return g_strdup (g_app_info_get_display_name (info));
+
+  return g_strdup (app_id);
+}
+
+static char *
+get_requested_capabilities (RemoteDesktopDeviceType device_types,
+                            ScreenCastSelection *screen_cast_select,
+                            gboolean clipboard_requested)
+{
+  g_autoptr(GString) capabilities = NULL;
+
+  capabilities = g_string_new (NULL);
+
+  if (screen_cast_select)
+    append_capability (capabilities, _("screen sharing"));
+
+  if (device_types & REMOTE_DESKTOP_DEVICE_TYPE_KEYBOARD)
+    append_capability (capabilities, _("keyboard control"));
+
+  if (device_types & REMOTE_DESKTOP_DEVICE_TYPE_POINTER)
+    append_capability (capabilities, _("pointer control"));
+
+  if (device_types & REMOTE_DESKTOP_DEVICE_TYPE_TOUCHSCREEN)
+    append_capability (capabilities, _("touch control"));
+
+  if (clipboard_requested)
+    append_capability (capabilities, _("clipboard access"));
+
+  if (capabilities->len == 0)
+    append_capability (capabilities, _("remote desktop access"));
+
+  return g_string_free (g_steal_pointer (&capabilities), FALSE);
+}
+
+static void
+set_requester_text (RemoteDesktopDialog *dialog,
+                    const char *app_id,
+                    RemoteDesktopDeviceType device_types,
+                    ScreenCastSelection *screen_cast_select,
+                    gboolean clipboard_requested)
+{
+  g_autofree char *display_name = NULL;
+  g_autofree char *heading = NULL;
+  g_autofree char *capabilities = NULL;
+  g_autofree char *details = NULL;
+
+  display_name = get_app_display_name (app_id);
+  capabilities = get_requested_capabilities (device_types,
+                                             screen_cast_select,
+                                             clipboard_requested);
+
+  if (app_id && strcmp (app_id, "") != 0)
+    {
+      heading = g_strdup_printf (_("%s wants to use remote desktop"),
+                                 display_name);
+      details = g_strdup_printf (_("App ID: %s\nRequested: %s"),
+                                 app_id,
+                                 capabilities);
+    }
+  else
+    {
+      heading = g_strdup (_("An app wants to use remote desktop"));
+      details = g_strdup_printf (_("Requested: %s"), capabilities);
+    }
+
+  gtk_label_set_label (dialog->requester_heading, heading);
+  gtk_label_set_label (dialog->requester_details, details);
+}
+
 RemoteDesktopDialog *
 remote_desktop_dialog_new (const char *app_id,
                            RemoteDesktopDeviceType device_types,
@@ -158,6 +259,11 @@ remote_desktop_dialog_new (const char *app_id,
 
   dialog = g_object_new (REMOTE_DESKTOP_TYPE_DIALOG, NULL);
   dialog->device_types = device_types;
+  set_requester_text (dialog,
+                      app_id,
+                      device_types,
+                      screen_cast_select,
+                      clipboard_requested);
   if (screen_cast_select)
     {
       dialog->screen_cast_enable = TRUE;
@@ -255,6 +361,8 @@ remote_desktop_dialog_class_init (RemoteDesktopDialogClass *klass)
   gtk_widget_class_bind_template_child (widget_class, RemoteDesktopDialog, allow_remote_interaction_switch);
   gtk_widget_class_bind_template_child (widget_class, RemoteDesktopDialog, allow_remote_clipboard_switch);
   gtk_widget_class_bind_template_child (widget_class, RemoteDesktopDialog, persist_check);
+  gtk_widget_class_bind_template_child (widget_class, RemoteDesktopDialog, requester_heading);
+  gtk_widget_class_bind_template_child (widget_class, RemoteDesktopDialog, requester_details);
   gtk_widget_class_bind_template_child (widget_class, RemoteDesktopDialog, screen_cast_widget);
   gtk_widget_class_bind_template_child (widget_class, RemoteDesktopDialog, titlebar);
   gtk_widget_class_bind_template_callback (widget_class, button_clicked);
diff --git a/src/remotedesktopdialog.ui b/src/remotedesktopdialog.ui
index d2051e1..f3be875 100644
--- a/src/remotedesktopdialog.ui
+++ b/src/remotedesktopdialog.ui
@@ -62,6 +62,35 @@
                     <property name="vexpand">1</property>
                     <property name="spacing">24</property>
 
+                    <child>
+                      <object class="GtkBox">
+                        <property name="orientation">vertical</property>
+                        <property name="spacing">6</property>
+
+                        <child>
+                          <object class="GtkLabel" id="requester_heading">
+                            <property name="xalign">0</property>
+                            <property name="wrap">True</property>
+                            <property name="label" translatable="yes">An app wants to use remote desktop</property>
+                            <style>
+                              <class name="title-3"/>
+                            </style>
+                          </object>
+                        </child>
+
+                        <child>
+                          <object class="GtkLabel" id="requester_details">
+                            <property name="xalign">0</property>
+                            <property name="wrap">True</property>
+                            <property name="label" translatable="yes">Requested: remote desktop access</property>
+                            <style>
+                              <class name="dim-label"/>
+                            </style>
+                          </object>
+                        </child>
+                      </object>
+                    </child>
+
                     <child>
                       <object class="GtkCheckButton" id="persist_check">
                         <property name="visible">False</property>
-- 
2.51.2

